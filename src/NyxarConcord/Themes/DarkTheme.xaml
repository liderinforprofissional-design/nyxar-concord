<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:NyxarConcord.Views">

    <!-- Conversores -->
    <conv:PathToImageConverter x:Key="PathToImage" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:IconKeyToGeometryConverter x:Key="IconGeom" />
    <conv:IconKeyToBrushConverter x:Key="IconBrush" />
    <conv:NullToVisibleConverter x:Key="NullToVis" />

    <!-- ============================================================
         Paleta — azul da logo (Nyxar), moderno, elegante, minimalista
         ============================================================ -->
    <Color x:Key="C.Accent">#29A3FF</Color>
    <Color x:Key="C.Accent2">#1E7BE8</Color>

    <SolidColorBrush x:Key="Bg.Darkest" Color="#0B1220" />
    <SolidColorBrush x:Key="Bg.Dark"    Color="#101A2E" />
    <SolidColorBrush x:Key="Bg.Mid"     Color="#16213A" />
    <SolidColorBrush x:Key="Bg.Card"    Color="#1B2740" />
    <SolidColorBrush x:Key="Bg.Hover"   Color="#243357" />
    <SolidColorBrush x:Key="Bg.Input"   Color="#0D1524" />
    <SolidColorBrush x:Key="Border.Soft" Color="#294066" />

    <SolidColorBrush x:Key="Accent"     Color="#1E96F5" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#0A6FE0" />
    <SolidColorBrush x:Key="Text.Primary" Color="#EAF2FD" />
    <SolidColorBrush x:Key="Text.Muted"   Color="#8FA0C0" />
    <SolidColorBrush x:Key="Online"     Color="#37D07A" />
    <SolidColorBrush x:Key="Badge"      Color="#FF5069" />

    <!-- Gradiente do brand (barra lateral / cabeçalhos) — diagonal, azul da logo -->
    <LinearGradientBrush x:Key="Brand.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3FB4FF" Offset="0" />
        <GradientStop Color="#1E96F5" Offset="0.55" />
        <GradientStop Color="#0F72E6" Offset="1" />
    </LinearGradientBrush>

    <!-- Gradiente glossy vertical para botões 3D (claro em cima → escuro embaixo) -->
    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#54BCFF" Offset="0" />
        <GradientStop Color="#1E96F5" Offset="0.5" />
        <GradientStop Color="#0A72E6" Offset="1" />
    </LinearGradientBrush>

    <!-- Brilho superior (highlight) sobreposto para dar aspecto de vidro -->
    <LinearGradientBrush x:Key="Gloss.Overlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#10FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="0.5" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Rail.Gradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F1930" Offset="0" />
        <GradientStop Color="#0A1120" Offset="1" />
    </LinearGradientBrush>

    <!-- Fundos com profundidade (degradês) para dar elegância -->
    <LinearGradientBrush x:Key="App.Bg" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#0A1322" Offset="0" />
        <GradientStop Color="#0D1A32" Offset="0.5" />
        <GradientStop Color="#080F1E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Chat.Bg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#16294A" Offset="0" />
        <GradientStop Color="#0A1424" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Header.Bg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#213656" Offset="0" />
        <GradientStop Color="#152340" Offset="1" />
    </LinearGradientBrush>

    <!-- Linha de destaque (accent) horizontal -->
    <LinearGradientBrush x:Key="Accent.Line" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2C9BF7" Offset="0" />
        <GradientStop Color="#1E7BE8" Offset="0.5" />
        <GradientStop Color="#0A6FE0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Sidebar.Bg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F1829" Offset="0" />
        <GradientStop Color="#0A1120" Offset="1" />
    </LinearGradientBrush>

    <!-- Balões de mensagem -->
    <LinearGradientBrush x:Key="Bubble.Mine" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C9BF7" Offset="0" />
        <GradientStop Color="#1878E7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Bubble.Other" Color="#1C2A45" />

    <!-- Botão de sala (com destaque suave no hover) -->
    <Style x:Key="ChannelButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}" Margin="6,1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="cb" Property="Background" Value="{StaticResource Bg.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

