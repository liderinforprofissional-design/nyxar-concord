<Window x:Class="NyxarConcord.Views.InternetInviteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conectar pela internet" Height="560" Width="500"
        Background="{StaticResource Bg.Darkest}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource Bg.Dark}" BorderBrush="{StaticResource Border.Soft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho com gradiente -->
            <Border Grid.Row="0" Height="112" CornerRadius="16,16,0,0" Background="{StaticResource Brand.Gradient}">
                <StackPanel VerticalAlignment="Center" Margin="28,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Globe}" Fill="White" Width="26" Height="26"
                              Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Conectar pela internet" Foreground="White" FontWeight="Bold"
                                   FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Fale com quem está fora da sua rede local" Foreground="#DCE7FF"
                               FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,22,28,0">
                <!-- Passo 1 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Compartilhe seu código" Foreground="{StaticResource Text.Primary}"
                               FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Background="{StaticResource Bg.Input}" BorderBrush="{StaticResource Border.Soft}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <TextBox x:Name="MyCode" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Text.Primary}" IsReadOnly="True"
                             TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" />
                </Border>
                <Button Content="Copiar meu código" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="Copy_Click" />

                <Border Height="1" Background="{StaticResource Border.Soft}" Margin="0,20,0,0" />

                <!-- Passo 2 -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Cole o código de um amigo" Foreground="{StaticResource Text.Primary}"
                               FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="PeerCode" Style="{StaticResource ChatTextBox}" TextWrapping="Wrap" Height="56"
                         FontFamily="Consolas" FontSize="12" />
                <Button Content="Conectar" Style="{StaticResource AccentButton}" Margin="0,12,0,0"
                        HorizontalAlignment="Right" Click="Connect_Click" />
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2" Padding="28,14" CornerRadius="0,0,16,16">
                <Grid>
                    <TextBlock Text="Requer IP público / redirecionamento de porta (por enquanto)."
                               FontSize="10" Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                    <Button Content="Fechar" Style="{StaticResource GhostButton}" Padding="14,7"
                            HorizontalAlignment="Right" Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
