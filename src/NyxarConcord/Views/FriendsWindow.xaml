<Window x:Class="NyxarConcord.Views.FriendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Amigos" Height="580" Width="400"
        Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource Bg.Dark}" BorderBrush="{StaticResource Border.Soft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,20,16,8" Background="Transparent" MouseLeftButtonDown="Header_Drag">
                <StackPanel>
                    <TextBlock Text="Amigos" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text.Primary}" />
                    <TextBlock Text="{Binding FriendsHeader}" FontSize="11" Foreground="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="xb" Width="28" Height="28" CornerRadius="14" Background="#1FFFFFFF">
                                <TextBlock Text="✕" Foreground="{StaticResource Text.Primary}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="xb" Property="Background" Value="{StaticResource Bg.Hover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0">
                <StackPanel>
                    <!-- ONLINE -->
                    <TextBlock Margin="12,10,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Online}">
                        <Run Text="ONLINE — " /><Run Text="{Binding OnlineFriends.Count, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding OnlineFriends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,3" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Friend_Click">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="38" Height="38" VerticalAlignment="Center">
                                        <Border CornerRadius="19" Background="{StaticResource Brand.Gradient}">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold"
                                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource PathToImage}}"
                                                            Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Fill="{StaticResource Online}" Stroke="{StaticResource Bg.Dark}" StrokeThickness="2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Handle}" Foreground="{StaticResource Text.Muted}" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- OFFLINE -->
                    <TextBlock Margin="12,14,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Muted}">
                        <Run Text="OFFLINE — " /><Run Text="{Binding OfflineFriends.Count, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding OfflineFriends}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,3" Cursor="Hand" Background="Transparent" Opacity="0.55" MouseLeftButtonUp="Friend_Click">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="38" Height="38" VerticalAlignment="Center">
                                        <Border CornerRadius="19" Background="{StaticResource Bg.Hover}">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold"
                                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource PathToImage}}"
                                                            Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Fill="{StaticResource Text.Muted}" Stroke="{StaticResource Bg.Dark}" StrokeThickness="2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                        <TextBlock Text="Offline" Foreground="{StaticResource Text.Muted}" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Seus contatos aparecem aqui conforme você entra em servidores com eles."
                               FontSize="10" Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap"
                               Margin="14,18,14,10" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="24,14">
                <Grid>
                    <TextBlock x:Name="Notice" VerticalAlignment="Center" HorizontalAlignment="Left"
                               FontSize="12" TextWrapping="Wrap" MaxWidth="230"
                               Foreground="{StaticResource Text.Muted}" Visibility="Collapsed" />
                    <Button Content="Fechar" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
