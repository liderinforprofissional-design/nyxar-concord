<Window x:Class="NyxarConcord.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NyxarConcord.Views"
        Title="Criar conta" Height="720" Width="440"
        Background="{StaticResource Bg.Darkest}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource Bg.Dark}" BorderBrush="{StaticResource Border.Soft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="130" CornerRadius="16,16,0,0" Background="{StaticResource Brand.Gradient}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Width="62" Height="62" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Click="ChoosePhoto_Click">
                        <Grid Width="62" Height="62">
                            <Border CornerRadius="31" Background="#22FFFFFF">
                                <TextBlock x:Name="AvatarInitials" Text="?" FontSize="24" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Width="62" Height="62">
                                <Ellipse.Fill><ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" /></Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Button>
                    <TextBlock Text="Toque para adicionar foto" Foreground="#DCE7FF" FontSize="10"
                               Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="30,10,30,20">
                <!-- ============ PAINEL 1: FORMULÁRIO ============ -->
                <StackPanel x:Name="FormPanel">
                    <local:BrandLogo Height="60" Margin="0,0,0,2" />
                    <TextBlock Text="Criar sua conta" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" />

                    <TextBlock Text="EMAIL" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,14,0,4" />
                    <TextBox x:Name="EmailInput" Style="{StaticResource ChatTextBox}" />

                    <TextBlock Text="NOME DE USUÁRIO" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,10,0,4" />
                    <TextBox x:Name="UsernameInput" Style="{StaticResource ChatTextBox}"
                             TextChanged="UsernameInput_TextChanged" />

                    <TextBlock Text="SENHA" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,10,0,4" />
                    <PasswordBox x:Name="PasswordInput" Background="{StaticResource Bg.Input}"
                                 Foreground="{StaticResource Text.Primary}" BorderBrush="{StaticResource Border.Soft}"
                                 BorderThickness="1" Padding="12,10" FontSize="14" />

                    <TextBlock Text="CONFIRMAR SENHA" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,10,0,4" />
                    <PasswordBox x:Name="ConfirmInput" Background="{StaticResource Bg.Input}"
                                 Foreground="{StaticResource Text.Primary}" BorderBrush="{StaticResource Border.Soft}"
                                 BorderThickness="1" Padding="12,10" FontSize="14" />

                    <Button x:Name="CreateButton" Content="Criar conta" Style="{StaticResource AccentButton}"
                            Margin="0,18,0,0" Height="44" Click="Register_Click" IsDefault="True" />

                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Hyperlink Foreground="{StaticResource Text.Muted}" Click="ShowLogin_Click"
                                   TextDecorations="None">
                            <Run Text="Já tenho uma conta — entrar" FontSize="12" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- ============ PAINEL 2: CÓDIGO ============ -->
                <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                    <local:BrandLogo Height="60" Margin="0,0,0,2" />
                    <TextBlock Text="Confirme seu e-mail" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CodeHint" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{StaticResource Text.Muted}" Margin="0,8,0,0"
                               Text="Enviamos um código de 6 dígitos para o seu e-mail." />

                    <TextBlock Text="CÓDIGO" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,18,0,4" />
                    <TextBox x:Name="CodeInput" Style="{StaticResource ChatTextBox}" MaxLength="6"
                             FontSize="22" FontWeight="Bold" TextAlignment="Center" />

                    <Button x:Name="VerifyButton" Content="Confirmar e ativar conta" Style="{StaticResource AccentButton}"
                            Margin="0,18,0,0" Height="44" Click="Verify_Click" />
                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Hyperlink Foreground="{StaticResource Text.Muted}" Click="BackToForm_Click"
                                   TextDecorations="None">
                            <Run Text="Voltar / corrigir dados" FontSize="12" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- ============ PAINEL 3: ENTRAR (conta existente) ============ -->
                <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
                    <local:BrandLogo Height="60" Margin="0,0,0,2" />
                    <TextBlock Text="Entrar" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" />
                    <TextBlock Text="Use a conta que você já criou (em qualquer computador)."
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                               Foreground="{StaticResource Text.Muted}" Margin="0,8,0,0" />

                    <TextBlock Text="E-MAIL OU USUÁRIO" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,18,0,4" />
                    <TextBox x:Name="LoginIdInput" Style="{StaticResource ChatTextBox}" />

                    <TextBlock Text="SENHA" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,10,0,4" />
                    <PasswordBox x:Name="LoginPassInput" Background="{StaticResource Bg.Input}"
                                 Foreground="{StaticResource Text.Primary}" BorderBrush="{StaticResource Border.Soft}"
                                 BorderThickness="1" Padding="12,10" FontSize="14" />

                    <Button x:Name="LoginButton" Content="Entrar" Style="{StaticResource AccentButton}"
                            Margin="0,18,0,0" Height="44" Click="ServerLogin_Click" />
                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Hyperlink Foreground="{StaticResource Text.Muted}" Click="BackToForm_Click"
                                   TextDecorations="None">
                            <Run Text="Criar uma conta nova" FontSize="12" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Status / erros (compartilhado) -->
                <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" TextWrapping="Wrap"
                           TextAlignment="Center" FontSize="12" Foreground="#FF7A7A" Margin="0,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
