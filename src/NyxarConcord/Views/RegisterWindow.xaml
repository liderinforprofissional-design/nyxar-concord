<Window x:Class="NyxarConcord.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NyxarConcord.Views"
        Title="Criar conta" Height="700" Width="440"
        Background="{StaticResource Bg.Darkest}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource Bg.Dark}" BorderBrush="{StaticResource Border.Soft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="140" CornerRadius="16,16,0,0" Background="{StaticResource Brand.Gradient}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Width="66" Height="66" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Click="ChoosePhoto_Click">
                        <Grid Width="66" Height="66">
                            <Border CornerRadius="33" Background="#22FFFFFF">
                                <TextBlock x:Name="AvatarInitials" Text="?" FontSize="26" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse Width="66" Height="66">
                                <Ellipse.Fill><ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" /></Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Button>
                    <TextBlock Text="Toque para adicionar foto" Foreground="#DCE7FF" FontSize="10"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="30,10,30,0">
                <local:BrandLogo Height="70" Margin="0,0,0,4" />
                <TextBlock Text="Criar sua conta" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" />

                <TextBlock Text="EMAIL" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Muted}" Margin="0,16,0,4" />
                <TextBox x:Name="EmailInput" Style="{StaticResource ChatTextBox}" />

                <TextBlock Text="NOME DE USUÁRIO" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Muted}" Margin="0,12,0,4" />
                <TextBox x:Name="UsernameInput" Style="{StaticResource ChatTextBox}"
                         TextChanged="UsernameInput_TextChanged" />

                <TextBlock Text="SENHA" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Muted}" Margin="0,12,0,4" />
                <PasswordBox x:Name="PasswordInput" Background="{StaticResource Bg.Input}"
                             Foreground="{StaticResource Text.Primary}" BorderBrush="{StaticResource Border.Soft}"
                             BorderThickness="1" Padding="12,10" FontSize="14" />

                <TextBlock Text="CONFIRMAR SENHA" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Muted}" Margin="0,12,0,4" />
                <PasswordBox x:Name="ConfirmInput" Background="{StaticResource Bg.Input}"
                             Foreground="{StaticResource Text.Primary}" BorderBrush="{StaticResource Border.Soft}"
                             BorderThickness="1" Padding="12,10" FontSize="14" />

                <Button Content="Criar conta e entrar" Style="{StaticResource AccentButton}"
                        Margin="0,20,0,0" Height="46" Click="Register_Click" IsDefault="True" />
                <TextBlock Text="A conta fica salva neste computador e o login não expira até você sair."
                           FontSize="10" Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
