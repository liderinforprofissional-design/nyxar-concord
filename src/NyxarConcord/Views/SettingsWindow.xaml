<Window x:Class="NyxarConcord.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Height="560" Width="500"
        Background="{StaticResource Bg.Darkest}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource Bg.Dark}" BorderBrush="{StaticResource Border.Soft}"
            BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0" Padding="28,22" CornerRadius="16,16,0,0">
                <StackPanel>
                    <TextBlock Text="Configurações" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Text.Primary}" />
                    <TextBlock Text="Perfil e dispositivos de áudio" FontSize="12"
                               Foreground="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,4,28,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Grid Width="60" Height="60">
                            <Border CornerRadius="30" Background="{StaticResource Brand.Gradient}">
                                <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource PathToImage}}"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button Content="Alterar foto" Style="{StaticResource GhostButton}" Padding="12,7"
                                    HorizontalAlignment="Left" Click="ChoosePhoto_Click" />
                            <Button Content="Remover" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Text.Muted}" Cursor="Hand"
                                    HorizontalAlignment="Left" Margin="2,4,0,0" Click="RemovePhoto_Click" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="NOME DE EXIBIÇÃO" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,10,0,6" />
                    <TextBox Style="{StaticResource ChatTextBox}"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="SEU PEER ID" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,18,0,6" />
                    <TextBox Style="{StaticResource ChatTextBox}" Text="{Binding PeerId, Mode=OneWay}"
                             IsReadOnly="True" Foreground="{StaticResource Text.Muted}" />

                    <Border Height="1" Background="{StaticResource Border.Soft}" Margin="0,22,0,4" />

                    <TextBlock Text="MICROFONE (ENTRADA)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" />

                    <!-- Teste de microfone com medidor de nível ao vivo -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding TestButtonLabel}" Click="TestMic_Click" Cursor="Hand"
                                Padding="14,7" FontWeight="SemiBold" BorderThickness="0"
                                Background="{StaticResource Accent}" Foreground="White" />
                        <Border Grid.Column="1" Margin="10,0,0,0" Height="12" VerticalAlignment="Center"
                                CornerRadius="6" Background="{StaticResource Bg.Input}" ClipToBounds="True">
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding MicLevel}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Online}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="ALTO-FALANTE / FONE (SAÍDA)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="0,18,0,6" />
                    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" />

                    <Border Background="{StaticResource Bg.Card}" CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Supressão de ruído" Foreground="{StaticResource Text.Primary}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Silencia ruídos de fundo do microfone" Foreground="{StaticResource Text.Muted}"
                                           FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding NoiseSuppression}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource Bg.Card}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sons do app" Foreground="{StaticResource Text.Primary}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Toca sons discretos ao enviar/receber mensagens e entrar/sair de call"
                                           Foreground="{StaticResource Text.Muted}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding SoundsEnabled}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Dica: reconecte dispositivos e reabra as configurações para atualizar a lista."
                               FontSize="10" Foreground="{StaticResource Text.Muted}" TextWrapping="Wrap"
                               Margin="0,14,0,0" />

                    <Border Height="1" Background="{StaticResource Border.Soft}" Margin="0,16,0,0" />
                    <Button Content="Sair da conta" HorizontalAlignment="Left" Margin="0,14,0,0" Cursor="Hand"
                            Background="{StaticResource Badge}" Foreground="White" BorderThickness="0"
                            Padding="16,9" FontWeight="SemiBold" Click="Logout_Click" />

                    <!-- Zona de perigo: desativar / excluir conta -->
                    <TextBlock Text="ZONA DE PERIGO" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Badge}" Margin="0,22,0,6" />

                    <Border Background="{StaticResource Bg.Card}" CornerRadius="10" Padding="14,12" Margin="0,0,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Desativar sua conta" Foreground="{StaticResource Text.Primary}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Desative temporariamente. Volta ao ativar quando você entrar de novo."
                                           Foreground="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="Desativar conta" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Cursor="Hand" Padding="14,8" FontWeight="SemiBold" Click="Deactivate_Click"
                                    Background="{StaticResource Bg.Input}" Foreground="{StaticResource Badge}"
                                    BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" />
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource Bg.Card}" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Encerrar sua conta" Foreground="{StaticResource Text.Primary}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Apaga a conta e todos os dados desta máquina. Não dá pra desfazer."
                                           Foreground="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="Excluir conta" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Cursor="Hand" Padding="14,8" FontWeight="SemiBold" Click="Delete_Click"
                                    Background="{StaticResource Badge}" Foreground="White" BorderThickness="0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Rodapé -->
            <Border Grid.Row="2" Padding="28,16" CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                            Click="Cancel_Click" />
                    <Button Content="Salvar" Style="{StaticResource AccentButton}" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
