<Window x:Class="NyxarConcord.Views.ScreenViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compartilhamento de tela" Height="640" Width="960"
        Background="#080B14" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Bg.Dark}" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="{StaticResource Badge}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="HeaderText" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="Tela compartilhada" />
            </StackPanel>
        </Border>
        <Image Grid.Row="1" Source="{Binding StreamFrame}" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="LowQuality" />
    </Grid>
</Window>
