<Window x:Class="NyxarConcord.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil" Height="470" Width="380"
        Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource Bg.Dark}" BorderBrush="{StaticResource Border.Soft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Banner + avatar + fechar -->
            <Grid Grid.Row="0">
                <Border Height="84" VerticalAlignment="Top" CornerRadius="16,16,0,0" Background="{StaticResource Brand.Gradient}" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                        Cursor="Hand" Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="xb" Width="28" Height="28" CornerRadius="14" Background="#22FFFFFF">
                                <TextBlock Text="✕" Foreground="White" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="xb" Property="Background" Value="#55FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Grid Width="92" Height="92" Margin="0,38,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Ellipse Width="92" Height="92" Fill="{StaticResource Bg.Dark}" />
                    <Border Width="82" Height="82" CornerRadius="41" Background="{StaticResource Bg.Card}">
                        <TextBlock x:Name="AvatarInitials" Foreground="White" FontWeight="Bold" FontSize="30"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Ellipse Width="82" Height="82">
                        <Ellipse.Fill><ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" /></Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,50,24,0" HorizontalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource Text.Primary}" />
                <TextBlock x:Name="HandleText" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource Text.Muted}" />
                <Border Background="{StaticResource Bg.Card}" CornerRadius="10" Padding="14" Margin="0,16,0,0" Width="300">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Text.Muted}" />
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource Text.Primary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Barra de mensagem (para outros usuários) -->
            <Border Grid.Row="2" x:Name="MessageBar" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0" Cursor="Hand"
                            Background="{StaticResource Bg.Card}" BorderThickness="0" Click="Attach_Click"
                            ToolTip="Enviar arquivo (até 100 MB)">
                        <Path Data="{StaticResource Icon.Paperclip}" Fill="{StaticResource Text.Muted}"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <TextBox x:Name="MsgInput" Grid.Column="1" Style="{StaticResource ChatTextBox}"
                             KeyDown="MsgInput_KeyDown" />
                    <Button Grid.Column="2" Width="44" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                            Click="Send_Click" ToolTip="Enviar (Enter)">
                        <Path Data="{StaticResource Icon.Send}" Fill="White" Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <!-- Rodapé para o próprio perfil -->
            <Border Grid.Row="2" x:Name="SelfFooter" Padding="24,16" Visibility="Collapsed">
                <Button Content="Fechar" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" />
            </Border>
        </Grid>
    </Border>
</Window>
