<UserControl x:Class="NyxarConcord.Views.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Balão original (Image) + "Concord" por cima, escalando junto via Viewbox -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1024" Height="1024">
            <Image x:Name="LogoImage" Width="1024" Height="1024" Stretch="Uniform" />
            <TextBlock Text="Concord" Foreground="White" FontWeight="Bold" FontSize="86"
                       FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="10,588,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#0A3A78" BlurRadius="6" ShadowDepth="2" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Viewbox>
</UserControl>
