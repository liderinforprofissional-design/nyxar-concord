<Window x:Class="NyxarConcord.Views.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NyxarConcord.Views"
        Title="Recuperar senha" Height="470" Width="400"
        Background="{StaticResource Bg.Darkest}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource Bg.Dark}" BorderBrush="{StaticResource Border.Soft}"
            BorderThickness="1">
        <Grid Margin="30,26,30,20">
            <!-- Etapa 1: pedir o código -->
            <StackPanel x:Name="EmailPanel">
                <local:BrandLogo Height="56" Margin="0,0,0,4" />
                <TextBlock Text="Recuperar senha" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" />
                <TextBlock Text="Enviaremos um código de 6 dígitos para o seu e-mail."
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Text.Muted}" Margin="0,8,0,0" />

                <TextBlock Text="E-MAIL" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Muted}" Margin="0,18,0,4" />
                <TextBox x:Name="EmailInput" Style="{StaticResource ChatTextBox}" />

                <Button x:Name="SendButton" Content="Enviar código" Style="{StaticResource AccentButton}"
                        Margin="0,18,0,0" Height="44" Click="Send_Click" IsDefault="True" />
            </StackPanel>

            <!-- Etapa 2: código + nova senha -->
            <StackPanel x:Name="ResetPanel" Visibility="Collapsed">
                <local:BrandLogo Height="56" Margin="0,0,0,4" />
                <TextBlock Text="Nova senha" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" />

                <TextBlock Text="CÓDIGO" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Muted}" Margin="0,14,0,4" />
                <TextBox x:Name="CodeInput" Style="{StaticResource ChatTextBox}" MaxLength="6"
                         FontSize="20" FontWeight="Bold" TextAlignment="Center" />

                <TextBlock Text="NOVA SENHA" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Muted}" Margin="0,12,0,4" />
                <PasswordBox x:Name="NewPassInput" Background="{StaticResource Bg.Input}"
                             Foreground="{StaticResource Text.Primary}" BorderBrush="{StaticResource Border.Soft}"
                             BorderThickness="1" Padding="12,10" FontSize="14" />

                <Button x:Name="ResetButton" Content="Redefinir senha" Style="{StaticResource AccentButton}"
                        Margin="0,18,0,0" Height="44" Click="Reset_Click" />
            </StackPanel>

            <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" TextWrapping="Wrap"
                       TextAlignment="Center" FontSize="12" Foreground="#FF7A7A" />
        </Grid>
    </Border>
</Window>
