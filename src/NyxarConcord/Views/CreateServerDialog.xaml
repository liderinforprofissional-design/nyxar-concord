<Window x:Class="NyxarConcord.Views.CreateServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar servidor" Height="420" Width="420"
        Background="{StaticResource Bg.Darkest}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource Bg.Dark}" BorderBrush="{StaticResource Border.Soft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="120" CornerRadius="16,16,0,0" Background="{StaticResource Brand.Gradient}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Width="64" Height="64" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Click="ChoosePhoto_Click">
                        <Grid Width="64" Height="64">
                            <Border CornerRadius="20" Background="#22FFFFFF">
                                <TextBlock Text="+" FontSize="30" Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Rectangle RadiusX="20" RadiusY="20">
                                <Rectangle.Fill><ImageBrush x:Name="AvatarPreview" Stretch="UniformToFill" /></Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Button>
                    <TextBlock Text="Toque para adicionar foto do servidor" Foreground="#DCE7FF" FontSize="10"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="26,22,26,0">
                <TextBlock Text="Crie seu servidor — depois adicione as salas que quiser."
                           FontSize="12" Foreground="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                <TextBlock Text="NOME DO SERVIDOR" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Muted}" Margin="0,18,0,6" />
                <TextBox x:Name="ServerName" Style="{StaticResource ChatTextBox}" Text="Meu servidor" />
            </StackPanel>

            <Border Grid.Row="2" Padding="26,16" CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button Content="Criar servidor" Style="{StaticResource AccentButton}" Click="Create_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
