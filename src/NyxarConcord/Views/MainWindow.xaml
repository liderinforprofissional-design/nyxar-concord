<Window x:Class="NyxarConcord.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NyxarConcord.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Nyxar Concord" Height="700" Width="1120" MinWidth="820" MinHeight="520"
        Background="{StaticResource App.Bg}" WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Botões da barra de título (min/max/fechar) no tema do app -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="{StaticResource Bg.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource App.Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ícone na bandeja do Windows (com balões de notificação) -->
        <tb:TaskbarIcon x:Name="TrayIcon" IconSource="/Assets/nyxar.ico" ToolTipText="Nyxar Concord"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick" />


        <!-- ==================== BARRA DE TÍTULO (tema do app) ==================== -->
        <Grid Grid.Row="0" Background="{StaticResource Header.Bg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Width="16" Height="16" Margin="0,0,8,0" Source="pack://application:,,,/Assets/nyxar.ico" />
                <TextBlock Text="{Binding AppTitle}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.Primary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="Min_Click" Content="&#xE921;" ToolTip="Minimizar" />
                <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Click="Max_Click" Content="&#xE922;" ToolTip="Maximizar" />
                <Button Style="{StaticResource CaptionCloseButton}" Click="WindowClose_Click" Content="&#xE8BB;" ToolTip="Fechar" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== RAIL: SERVIDORES ==================== -->
        <Border Grid.Column="0" Background="{StaticResource Rail.Gradient}">
            <DockPanel>
                <!-- Home (DMs) -->
                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                    <Button Style="{StaticResource IconRailButton}" ToolTip="Mensagens diretas" Click="Home_Click">
                        <Path Data="{StaticResource Icon.Message}" Fill="{StaticResource Text.Primary}"
                              Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Border Height="1" Background="{StaticResource Border.Soft}" Margin="16,4,16,4" />
                </StackPanel>

                <!-- Criar servidor + configurações (base) -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                    <Button Style="{StaticResource IconRailButton}" ToolTip="Amigos (online e offline)" Click="Friends_Click">
                        <Path Data="{StaticResource Icon.People}" Fill="{StaticResource Text.Primary}"
                              Width="24" Height="24" Stretch="Uniform" />
                    </Button>
                    <Border Height="1" Background="{StaticResource Border.Soft}" Margin="16,4,16,4" />
                    <Button Style="{StaticResource IconRailButton}" ToolTip="Criar servidor" Click="CreateServer_Click">
                        <Path Data="{StaticResource Icon.Plus}" Fill="{StaticResource Online}"
                              Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource IconRailButton}" ToolTip="Conectar pela internet" Click="InternetInvite_Click">
                        <Path Data="{StaticResource Icon.Globe}" Fill="{StaticResource Text.Primary}"
                              Width="20" Height="20" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource IconRailButton}" ToolTip="Configurações" Click="Settings_Click">
                        <Path Data="{StaticResource Icon.Gear}" Fill="{StaticResource Text.Primary}"
                              Width="20" Height="20" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- Lista de servidores -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ServerRailButton}" Click="Server_Click" Tag="{Binding}"
                                        ToolTip="{Binding Name}" ContextMenuOpening="ServerMenu_Opening">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Alterar foto" Click="ChangeServerPhoto_Click" />
                                            <MenuItem Header="Excluir servidor" Click="DeleteServer_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <Border CornerRadius="16" Background="{StaticResource Brand.Gradient}">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                                       FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Rectangle RadiusX="16" RadiusY="16">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource PathToImage}}"
                                                            Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <!-- Selo verde: tem gente numa sala de voz deste servidor -->
                                        <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,-3,-3"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{StaticResource Online}"
                                                BorderBrush="{StaticResource Bg.Dark}" BorderThickness="2"
                                                ToolTip="Há pessoas na sala de voz"
                                                Visibility="{Binding HasVoiceActivity, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{StaticResource Icon.Volume}" Fill="White"
                                                  Width="10" Height="10" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="1" Background="{StaticResource Sidebar.Bg}">
            <DockPanel>
                <!-- Cabeçalho -->
                <Border DockPanel.Dock="Top" Height="60" Padding="18,0" Background="{StaticResource Header.Bg}"
                        BorderBrush="{StaticResource Accent.Line}" BorderThickness="0,0,0,2">
                    <Grid>
                        <TextBlock Text="{Binding ServerName}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left" Margin="0,0,54,0" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource Bg.Card}"
                                CornerRadius="6" Padding="7,2" ToolTip="{Binding AppTitle}">
                            <TextBlock Text="{Binding AppVersionLabel}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Muted}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Rodapé: perfil -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg.Darkest}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                            <Border CornerRadius="19" Background="{StaticResource Brand.Gradient}">
                                <TextBlock Text="{Binding SelfInitials}" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SelfAvatarPath, Converter={StaticResource PathToImage}}"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelfName}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelfHandle}" FontSize="10"
                                       Foreground="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Click="SelfProfile_Click" ToolTip="Ver meu perfil" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- SALAS do servidor -->
                        <StackPanel Visibility="{Binding HasServer, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="18,14,12,4">
                                <TextBlock Text="SALAS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="Criar sala" Click="CreateChannel_Click" Padding="4"
                                        Visibility="{Binding CanModerate, Converter={StaticResource BoolToVis}}">
                                    <Path Data="{StaticResource Icon.Plus}" Fill="{StaticResource Text.Muted}"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Button Style="{StaticResource ChannelButton}"
                                                    Click="Channel_Click" Tag="{Binding}"
                                                    ContextMenuOpening="RoomMenu_Opening">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{Binding LockLabel}" Click="ToggleLock_Click" />
                                                        <MenuItem Header="Excluir sala" Click="DeleteChannel_Click" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="24" Height="24" Stretch="Uniform" Margin="2,0,9,0"
                                                          VerticalAlignment="Center"
                                                          Data="{Binding Emoji, Converter={StaticResource IconGeom}}"
                                                          Fill="{Binding Emoji, Converter={StaticResource IconBrush}}" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" />
                                                    <TextBlock Text="🔒" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}" />
                                                    <!-- Cronômetro da call ao lado do nome da sala -->
                                                    <Border Background="{StaticResource Bg.Card}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding ShowCallTimer, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.Clock}" Width="11" Height="11" Stretch="Uniform"
                                                                  Fill="{StaticResource Online}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding CallTimer}" Foreground="{StaticResource Text.Primary}"
                                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Button>

                                            <!-- Conectados nesta sala de voz (estilo Discord) -->
                                            <ItemsControl ItemsSource="{Binding Members}" Margin="42,0,8,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3" Cursor="Hand" Background="Transparent"
                                                              MouseLeftButtonUp="Member_Click"
                                                              ContextMenuOpening="Member_ContextMenuOpening">
                                                            <Grid.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="{Binding MuteMenuLabel}" Click="ToggleMute_Click" />
                                                                    <MenuItem Header="{Binding WatchMenuLabel}" Click="ToggleWatch_Click"
                                                                              Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVis}}" />
                                                                    <MenuItem StaysOpenOnClick="True">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Width="170" Margin="2">
                                                                                <TextBlock Text="Volume" FontSize="11" Foreground="{StaticResource Text.Muted}" />
                                                                                <Slider Minimum="0" Maximum="2" Width="160" TickFrequency="0.5"
                                                                                        Value="{Binding Volume, Mode=TwoWay}" ValueChanged="Volume_Changed" />
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                </ContextMenu>
                                                            </Grid.ContextMenu>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="30" Height="30" VerticalAlignment="Center">
                                                                <Border CornerRadius="15" Background="{StaticResource Brand.Gradient}">
                                                                    <TextBlock Text="{Binding Initials}" Foreground="White"
                                                                               FontWeight="SemiBold" FontSize="12"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Ellipse Width="30" Height="30">
                                                                    <Ellipse.Fill>
                                                                        <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource PathToImage}}"
                                                                                    Stretch="UniformToFill" />
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                                <Ellipse Width="30" Height="30" Stroke="{StaticResource Online}" StrokeThickness="2"
                                                                         Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}" />
                                                                <!-- Selo de "silenciado por mim" sobre o avatar -->
                                                                <Border Width="12" Height="12" CornerRadius="6"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                        Background="{StaticResource Badge}"
                                                                        BorderBrush="{StaticResource Bg.Dark}" BorderThickness="1.5"
                                                                        ToolTip="Você silenciou esta pessoa"
                                                                        Visibility="{Binding IsMutedByMe, Converter={StaticResource BoolToVis}}">
                                                                    <Path Data="{StaticResource Icon.VolumeOff}" Width="7" Height="7"
                                                                          Stretch="Uniform" Fill="White" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                       Foreground="{StaticResource Text.Muted}" FontSize="13"
                                                                       VerticalAlignment="Center" Margin="9,0,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Selo de administrador do servidor -->
                                                                <Border Background="#26F5B301" CornerRadius="5" Padding="4,1" Margin="3,0" VerticalAlignment="Center"
                                                                        ToolTip="Administrador do servidor"
                                                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="{StaticResource Icon.Crown}" Width="10" Height="10" Stretch="Uniform"
                                                                              Fill="{StaticResource Gold}" VerticalAlignment="Center" />
                                                                        <TextBlock Text="ADM" Foreground="{StaticResource Gold}" FontSize="9" FontWeight="Bold"
                                                                                   VerticalAlignment="Center" Margin="3,0,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Path Data="{StaticResource Icon.MicOff}" Width="13" Height="13" Margin="3,0"
                                                                      Stretch="Uniform" Fill="{StaticResource Text.Muted}"
                                                                      ToolTip="Microfone silenciado"
                                                                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                                                                <Path Data="{StaticResource Icon.VolumeOff}" Width="13" Height="13" Margin="3,0"
                                                                      Stretch="Uniform" Fill="{StaticResource Badge}"
                                                                      ToolTip="Você silenciou esta pessoa"
                                                                      Visibility="{Binding IsMutedByMe, Converter={StaticResource BoolToVis}}" />
                                                                <Path Data="{StaticResource Icon.Monitor}" Width="14" Height="14" Margin="3,0"
                                                                      Stretch="Uniform" Fill="{StaticResource Badge}"
                                                                      ToolTip="Transmitindo"
                                                                      Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- MENSAGENS DIRETAS (home) -->
                        <StackPanel Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MENSAGENS DIRETAS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Muted}" Margin="18,14,0,4" />

                            <!-- Você (anotações pessoais) -->
                            <Button HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="12,6" Margin="6,1" Click="SelfNotes_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                                        <Border CornerRadius="17" Background="{StaticResource Brand.Gradient}">
                                            <TextBlock Text="{Binding SelfInitials}" Foreground="White" FontWeight="SemiBold"
                                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse Width="34" Height="34">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding SelfAvatarPath, Converter={StaticResource PathToImage}}"
                                                            Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelfName}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text.Primary}" />
                                            <Border Background="{StaticResource Bg.Card}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                                <TextBlock Text="você" FontSize="9" Foreground="{StaticResource Text.Muted}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Anotações pessoais" FontSize="10" Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border Height="1" Background="{StaticResource Border.Soft}" Margin="14,6" />

                            <ListBox ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="Margin" Value="6,1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="b" Background="Transparent" CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{StaticResource Bg.Card}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="34" Height="34" VerticalAlignment="Center">
                                                <Border CornerRadius="17" Background="{StaticResource Bg.Hover}">
                                                    <TextBlock Text="{Binding Initials}" Foreground="{StaticResource Text.Primary}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Fill="{StaticResource Online}" Stroke="{StaticResource Bg.Dark}" StrokeThickness="2" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text.Primary}" />
                                                <TextBlock Text="{Binding Handle}" FontSize="10"
                                                           Foreground="{StaticResource Text.Muted}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{StaticResource Badge}" CornerRadius="9"
                                                    MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== CONTEÚDO ==================== -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- Cabeçalho + controles -->
                <Border DockPanel.Dock="Top" Height="60" Background="{StaticResource Header.Bg}" Padding="20,0"
                        BorderBrush="{StaticResource Accent.Line}" BorderThickness="0,0,0,2">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConversationTitle}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}" />
                            <TextBlock Text="{Binding ConversationSubtitle}" FontSize="11"
                                       Foreground="{StaticResource Text.Muted}" />
                        </StackPanel>

                        <!-- Resolução da transmissão (só quem transmite): centralizada na barra.
                             Ícone com borda vermelha fininha + setinha; clique troca a resolução AO VIVO. -->
                        <Button x:Name="ResBtn" Click="Resolution_Click" Cursor="Hand"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="Resolução da transmissão (clique para alterar)"
                                Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVis}}"
                                Height="36" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="resb" Background="{StaticResource Bg.Card}" CornerRadius="9" Padding="8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Ícone com borda vermelha bem fininha -->
                                            <Border BorderBrush="{StaticResource Badge}" BorderThickness="1" CornerRadius="5" Padding="3">
                                                <Path Data="{StaticResource Icon.Monitor}" Width="14" Height="14" Stretch="Uniform"
                                                      Fill="{StaticResource Text.Primary}" />
                                            </Border>
                                            <TextBlock Text="{Binding ShareResolutionLabel}" Foreground="{StaticResource Text.Primary}"
                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="7,0,5,0" />
                                            <!-- Setinha -->
                                            <Path Data="M7,10L12,15L17,10Z" Fill="{StaticResource Text.Muted}"
                                                  Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="resb" Property="Background" Value="{StaticResource Bg.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Popup x:Name="ResPopup" PlacementTarget="{Binding ElementName=ResBtn}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                            <Border Background="{StaticResource Bg.Card}" CornerRadius="10" Padding="6"
                                    BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                <StackPanel Width="210">
                                    <TextBlock Text="Resolução da transmissão" Foreground="{StaticResource Text.Muted}"
                                               FontSize="11" Margin="8,4,0,6" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding ResolutionOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" Click="ResolutionPick_Click" Tag="{Binding}"
                                                        HorizontalContentAlignment="Left" Margin="0,1">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ib" Background="Transparent" CornerRadius="8" Padding="10,7">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ib" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="{Binding StringFormat={}{0}p}" Foreground="{StaticResource Text.Primary}"
                                                               FontWeight="SemiBold" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Separador + opção de não assistir a própria tela -->
                                    <Border Height="1" Background="{StaticResource Border.Soft}" Margin="6,6" />
                                    <Button Cursor="Hand" Click="HideSelfView_Click" HorizontalContentAlignment="Left" Margin="0,1"
                                            ToolTip="Poupa recursos de quem transmite (só oculta o seu próprio preview)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="hb" Background="Transparent" CornerRadius="8" Padding="10,7">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.EyeOff}" Width="15" Height="15" Stretch="Uniform"
                                                              Fill="{StaticResource Text.Primary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding HideSelfViewLabel}" Foreground="{StaticResource Text.Primary}"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="hb" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding HasRoom, Converter={StaticResource BoolToVis}}">
                            <Button ToolTip="{Binding MicToolTip}" Click="MuteMic_Click" Cursor="Hand"
                                    Visibility="{Binding InCall, Converter={StaticResource BoolToVis}}"
                                    Width="42" Height="36" Margin="0,0,6,0" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource Bg.Card}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="mb" Background="{TemplateBinding Background}" CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="mb" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                                            <Setter TargetName="mb" Property="Background" Value="{StaticResource Badge}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Path Width="18" Height="18" Stretch="Uniform" Fill="White" Data="{StaticResource Icon.Mic}"
                                          Visibility="{Binding IsMicMuted, Converter={StaticResource InverseBoolToVis}}" />
                                    <Path Width="18" Height="18" Stretch="Uniform" Fill="White" Data="{StaticResource Icon.MicOff}"
                                          Visibility="{Binding IsMicMuted, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                            <!-- Setinha do microfone: volume de entrada -->
                            <Button x:Name="InVolBtn" Click="InputVol_Click" Cursor="Hand" ToolTip="Volume de entrada"
                                    Visibility="{Binding InCall, Converter={StaticResource BoolToVis}}"
                                    Width="16" Height="36" Margin="-4,0,4,0" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ib" Background="Transparent" CornerRadius="6">
                                            <Path Data="M7,10L12,15L17,10Z" Fill="{StaticResource Text.Muted}"
                                                  Width="11" Height="11" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ib" Property="Background" Value="{StaticResource Bg.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="InVolPopup" PlacementTarget="{Binding ElementName=InVolBtn}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-40" VerticalOffset="6">
                                <Border Background="{StaticResource Bg.Card}" CornerRadius="12" Padding="16"
                                        BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" Width="230">
                                    <StackPanel>
                                        <TextBlock Text="Volume de entrada" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" FontSize="12" />
                                        <Slider Minimum="0" Maximum="3" Value="{Binding InputVolume, Mode=TwoWay}" Margin="0,10,0,0" />
                                        <Border Height="1" Background="{StaticResource Border.Soft}" Margin="0,10" />
                                        <Button Content="⚙  Configurações de voz" Click="Settings_Click" HorizontalAlignment="Left"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource Text.Muted}" Padding="0" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Fone: ensurdecer (não ouvir os outros da sala) -->
                            <Button ToolTip="{Binding DeafenToolTip}" Click="Deafen_Click" Cursor="Hand"
                                    Visibility="{Binding InCall, Converter={StaticResource BoolToVis}}"
                                    Width="42" Height="36" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource Bg.Card}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="db" Background="{TemplateBinding Background}" CornerRadius="9">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="db" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsDeafened}" Value="True">
                                                            <Setter TargetName="db" Property="Background" Value="{StaticResource Badge}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Path Width="18" Height="18" Stretch="Uniform" Fill="White" Data="{StaticResource Icon.Headset}"
                                          Visibility="{Binding IsDeafened, Converter={StaticResource InverseBoolToVis}}" />
                                    <Path Width="18" Height="18" Stretch="Uniform" Fill="White" Data="{StaticResource Icon.HeadsetOff}"
                                          Visibility="{Binding IsDeafened, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                            <!-- Setinha do fone: volume de saída -->
                            <Button x:Name="OutVolBtn" Click="OutputVol_Click" Cursor="Hand" ToolTip="Volume de saída"
                                    Visibility="{Binding InCall, Converter={StaticResource BoolToVis}}"
                                    Width="16" Height="36" Margin="-4,0,6,0" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ob" Background="Transparent" CornerRadius="6">
                                            <Path Data="M7,10L12,15L17,10Z" Fill="{StaticResource Text.Muted}"
                                                  Width="11" Height="11" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ob" Property="Background" Value="{StaticResource Bg.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="OutVolPopup" PlacementTarget="{Binding ElementName=OutVolBtn}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-140" VerticalOffset="6">
                                <Border Background="{StaticResource Bg.Card}" CornerRadius="12" Padding="16"
                                        BorderBrush="{StaticResource Border.Soft}" BorderThickness="1" Width="230">
                                    <StackPanel>
                                        <TextBlock Text="Volume de saída" Foreground="{StaticResource Text.Primary}" FontWeight="SemiBold" FontSize="12" />
                                        <Slider Minimum="0" Maximum="1" Value="{Binding OutputVolume, Mode=TwoWay}" Margin="0,10,0,0" />
                                        <Border Height="1" Background="{StaticResource Border.Soft}" Margin="0,10" />
                                        <Button Content="⚙  Configurações de voz" Click="Settings_Click" HorizontalAlignment="Left"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource Text.Muted}" Padding="0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button Style="{StaticResource CallButton}" ToolTip="{Binding GalleryToggleTip}" Click="ToggleGallery_Click"
                                    Visibility="{Binding CanUseGallery, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Path Data="{StaticResource Icon.Grid}" Fill="{StaticResource Text.Primary}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          Visibility="{Binding GalleryView, Converter={StaticResource InverseBoolToVis}}" />
                                    <Path Data="{StaticResource Icon.Message}" Fill="{StaticResource Text.Primary}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          Visibility="{Binding GalleryView, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CallButton}" ToolTip="Convidar para o servidor" Click="Invite_Click">
                                <Path Data="{StaticResource Icon.AccountPlus}" Fill="{StaticResource Text.Primary}"
                                      Width="20" Height="20" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource CallButton}" ToolTip="Compartilhar tela (só em call)"
                                    IsEnabled="{Binding CanShareScreen}" Click="ShareScreen_Click"
                                    Visibility="{Binding IsSharingScreen, Converter={StaticResource InverseBoolToVis}}">
                                <Path Data="{StaticResource Icon.Monitor}" Fill="{StaticResource Text.Primary}"
                                      Width="20" Height="20" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource HangupButton}" ToolTip="Parar de transmitir" Click="StopShare_Click"
                                    Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVis}}">
                                <Rectangle Width="13" Height="13" Fill="White" RadiusX="2" RadiusY="2" />
                            </Button>
                            <Button Style="{StaticResource HangupButton}" ToolTip="Sair do canal de voz"
                                    IsEnabled="{Binding InCall}" Click="Hangup_Click">
                                <Path Data="{StaticResource Icon.PhoneHangup}" Fill="White"
                                      Width="20" Height="20" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Barra de digitação -->
                <Border DockPanel.Dock="Bottom" Padding="20,14" Background="{StaticResource Bg.Dark}"
                        Visibility="{Binding ShowChat, Converter={StaticResource BoolToVis}}">
                  <StackPanel>
                    <Border Margin="0,0,0,8" Background="{StaticResource Bg.Card}" CornerRadius="8" Padding="12,8"
                            Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding TransferStatus}" Foreground="{StaticResource Text.Primary}" FontSize="11" />
                            <ProgressBar Value="{Binding TransferProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="6"
                                         Margin="0,6,0,0" Background="{StaticResource Bg.Input}" Foreground="{StaticResource Accent}"
                                         BorderThickness="0" />
                        </StackPanel>
                    </Border>
                    <Grid IsEnabled="{Binding CanChat}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="44" Height="44" Margin="0,0,10,0" Cursor="Hand"
                                Background="{StaticResource Bg.Card}" BorderThickness="0"
                                Click="Attach_Click" ToolTip="Enviar arquivo (até 100 MB)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ab" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ab" Property="Background" Value="{StaticResource Bg.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Data="{StaticResource Icon.Paperclip}" Fill="{StaticResource Text.Muted}"
                                  Width="20" Height="20" Stretch="Uniform" />
                        </Button>
                        <TextBox x:Name="MessageInput" Grid.Column="1" Style="{StaticResource ChatTextBox}"
                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" KeyDown="MessageInput_KeyDown" />
                        <Button Grid.Column="2" Margin="10,0,0,0" Width="48" Height="44" Padding="0"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding SendCommand}" ToolTip="Enviar (Enter)">
                            <Path Data="{StaticResource Icon.Send}" Fill="White" Width="20" Height="20" Stretch="Uniform" />
                        </Button>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Central: chat OU palco -->
                <Grid Background="{StaticResource Chat.Bg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Accent}" Padding="16,10"
                            Visibility="{Binding ShowWatchBanner, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="White" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding StreamBarText}" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="Assistir" HorizontalAlignment="Right" Padding="14,6" Cursor="Hand"
                                    Background="White" Foreground="{StaticResource Accent}" BorderThickness="0"
                                    FontWeight="SemiBold" Click="Watch_Click" />
                        </Grid>
                    </Border>

                    <!-- Marca d'água: logo oficial (com "Concord") ao fundo das mensagens diretas -->
                    <local:BrandLogo Grid.Row="1" Width="360" Height="360" Opacity="0.5" IsHitTestVisible="False"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding ShowChatWatermark, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer x:Name="MessageScroll" Grid.Row="1" Padding="20,12" Background="Transparent"
                                  Visibility="{Binding ShowChat, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <!-- Aviso do sistema: centralizado e discreto -->
                                        <Border HorizontalAlignment="Center" Background="#16FFFFFF" CornerRadius="12"
                                                Padding="14,6" Margin="0,4"
                                                Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource Text.Muted}"
                                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Border>

                                        <!-- Mensagem normal -->
                                        <Grid Visibility="{Binding IsSystem, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                                    Background="{StaticResource Brand.Gradient}" Cursor="Hand"
                                                    MouseLeftButtonUp="MessageAvatar_Click">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#0A6FE0" BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
                                                </Border.Effect>
                                                <TextBlock Text="{Binding SenderInitials}" Foreground="White" FontWeight="Bold"
                                                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SenderName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Text.Primary}" />
                                                    <TextBlock Text="{Binding TimeLabel}" FontSize="10" Margin="8,2,0,0"
                                                               Foreground="{StaticResource Text.Muted}" />
                                                </StackPanel>

                                                <!-- Balão de texto -->
                                                <Border x:Name="bubble" Margin="0,4,0,0" HorizontalAlignment="Left" MaxWidth="560"
                                                        Background="{StaticResource Bubble.Other}" CornerRadius="4,14,14,14"
                                                        Padding="13,9"
                                                        Visibility="{Binding IsFile, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock x:Name="btext" Text="{Binding Text}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Text.Primary}" />
                                                </Border>

                                                <!-- Preview de LINK (Open Graph) -->
                                                <Border Margin="0,4,0,0" HorizontalAlignment="Left" MaxWidth="440" CornerRadius="8"
                                                        Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}"
                                                        BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="LinkPreview_Click"
                                                        Tag="{Binding Link.Url}"
                                                        Visibility="{Binding Link.IsLoaded, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{StaticResource Accent}" CornerRadius="8,0,0,8" />
                                                        <StackPanel Grid.Column="1" Margin="12,10">
                                                            <TextBlock Text="{Binding Link.SiteName}" Foreground="{StaticResource Text.Muted}"
                                                                       FontSize="10" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Link.Title}" Foreground="{StaticResource Accent}"
                                                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Link.Description}" Foreground="{StaticResource Text.Primary}"
                                                                       FontSize="12" TextWrapping="Wrap" MaxHeight="72" Margin="0,4,0,0"
                                                                       Visibility="{Binding Link.HasDescription, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                                            <Image Source="{Binding Link.Image}" Stretch="Uniform" MaxWidth="400" MaxHeight="220"
                                                                   Margin="0,8,0,0" RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding Link.HasImage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Preview de IMAGEM -->
                                                <Border Margin="0,4,0,0" HorizontalAlignment="Left" CornerRadius="12" Padding="6"
                                                        Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding IsImageFile, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <Image Source="{Binding ImagePreview}" Stretch="Uniform"
                                                               MaxWidth="340" MaxHeight="320"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <Grid Margin="4,6,2,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Text.Muted}"
                                                                       FontSize="10" MaxWidth="240" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1" Content="Salvar" Style="{StaticResource GhostButton}"
                                                                    Padding="10,4" Click="SaveFile_Click"
                                                                    Visibility="{Binding CanSaveFile, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Preview de VÍDEO (clique para reproduzir/pausar) -->
                                                <Border Margin="0,4,0,0" HorizontalAlignment="Left" CornerRadius="12" Padding="6"
                                                        Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding IsVideoFile, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <Grid MaxWidth="360" MaxHeight="320">
                                                            <MediaElement Source="{Binding MediaPath}" Stretch="Uniform"
                                                                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                                          ScrubbingEnabled="True" MaxWidth="360" MaxHeight="320"
                                                                          MediaOpened="Video_Opened" MediaEnded="Video_Ended" />
                                                            <Grid Background="#01000000" Cursor="Hand" MouseLeftButtonUp="Video_Toggle">
                                                                <Border x:Name="playBadge" Width="54" Height="54" CornerRadius="27"
                                                                        Background="#99000000" HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource Icon.Play}" Fill="White"
                                                                          Width="22" Height="22" Stretch="Uniform" Margin="4,0,0,0"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                        <Grid Margin="4,6,2,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Text.Muted}"
                                                                       FontSize="10" MaxWidth="260" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="1" Content="Salvar" Style="{StaticResource GhostButton}"
                                                                    Padding="10,4" Click="SaveFile_Click"
                                                                    Visibility="{Binding CanSaveFile, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Card de arquivo comum (nem imagem nem vídeo) -->
                                                <Border Margin="0,4,0,0" Background="{StaticResource Bg.Card}" CornerRadius="12"
                                                        Padding="10" HorizontalAlignment="Left"
                                                        BorderBrush="{StaticResource Border.Soft}" BorderThickness="1"
                                                        Visibility="{Binding IsOtherFile, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                                                Background="{StaticResource Bg.Input}">
                                                            <Path Data="{StaticResource Icon.File}" Fill="{StaticResource Accent}"
                                                                  Width="22" Height="22" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" MaxWidth="240">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Text.Primary}"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FileSizeLabel}" Foreground="{StaticResource Text.Muted}"
                                                                       FontSize="10" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="Salvar" Style="{StaticResource GhostButton}"
                                                                Padding="12,6" VerticalAlignment="Center" Click="SaveFile_Click"
                                                                Visibility="{Binding CanSaveFile, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter TargetName="bubble" Property="Background" Value="{StaticResource Bubble.Mine}" />
                                            <Setter TargetName="btext" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Background="#080B14"
                          Visibility="{Binding ShowStage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Grade de até 4 telas -->
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding Streams}"
                                      Visibility="{Binding IsMaximized, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Background="#05070E" CornerRadius="8" Cursor="Hand"
                                            BorderBrush="{StaticResource Border.Soft}" BorderThickness="1"
                                            MouseLeftButtonUp="Tile_Click" Tag="{Binding}">
                                        <Grid>
                                            <Image Source="{Binding Frame}" Stretch="Uniform" Margin="4"
                                                   RenderOptions.BitmapScalingMode="LowQuality" />
                                            <TextBlock Text="Aguardando..." Foreground="{StaticResource Text.Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Frame}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8"
                                                    Background="#B0000000" CornerRadius="5" Padding="8,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Badge}"
                                                             VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding SharerName}" Foreground="White" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Espectador: mutar o áudio desta transmissão -->
                                            <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                                                    Cursor="Hand" Click="StreamMute_Click" Tag="{Binding}"
                                                    ToolTip="Mutar/ativar o áudio desta transmissão"
                                                    Visibility="{Binding IsSelf, Converter={StaticResource InverseBoolToVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="tv" Width="34" Height="34" CornerRadius="10"
                                                                Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="tv" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Path Width="17" Height="17" Stretch="Uniform" Fill="{StaticResource Online}" Data="{StaticResource Icon.Headset}"
                                                          Visibility="{Binding IsMutedByMe, Converter={StaticResource InverseBoolToVis}}" />
                                                    <Path Width="17" Height="17" Stretch="Uniform" Fill="{StaticResource Badge}" Data="{StaticResource Icon.HeadsetOff}"
                                                          Visibility="{Binding IsMutedByMe, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Button>
                                            <!-- Espectador: parar de assistir esta transmissão (só para mim) -->
                                            <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,50,0"
                                                    Cursor="Hand" Click="StopWatch_Click" Tag="{Binding}"
                                                    ToolTip="Parar de assistir (só para você)"
                                                    Visibility="{Binding IsSelf, Converter={StaticResource InverseBoolToVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="sw" Width="34" Height="34" CornerRadius="10"
                                                                Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="sw" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Path Data="{StaticResource Icon.EyeOff}" Width="17" Height="17"
                                                      Stretch="Uniform" Fill="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                            <!-- Espaço reservado quando parei de assistir: botão para voltar -->
                                            <Border Background="#DD05070E"
                                                    Visibility="{Binding IsWatchBlocked, Converter={StaticResource BoolToVis}}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.EyeOff}" Width="24" Height="24" Stretch="Uniform"
                                                          Fill="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Você parou de assistir" Foreground="{StaticResource Text.Primary}"
                                                               FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                                    <Button Content="Voltar a assistir" Click="ResumeWatch_Click" Tag="{Binding}"
                                                            Cursor="Hand" Margin="0,10,0,0" Padding="12,6" BorderThickness="0"
                                                            Background="{StaticResource Accent}" Foreground="White"
                                                            FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tela maximizada (clique para voltar à grade) -->
                        <Grid Grid.Row="0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Restore_Click"
                              Visibility="{Binding IsMaximized, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding MaximizedStream.Frame}" Stretch="Uniform" Margin="8"
                                   RenderOptions.BitmapScalingMode="LowQuality" />
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14"
                                    Background="#B0000000" CornerRadius="6" Padding="10,5">
                                <TextBlock Text="{Binding MaximizedStream.SharerName}" Foreground="White" />
                            </Border>
                            <!-- Espectador: mutar o áudio da transmissão maximizada -->
                            <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="14"
                                    Cursor="Hand" Click="StreamMute_Click" Tag="{Binding MaximizedStream}"
                                    ToolTip="Mutar/ativar o áudio desta transmissão"
                                    Visibility="{Binding MaximizedStream.IsSelf, Converter={StaticResource InverseBoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="mv" Width="40" Height="40" CornerRadius="11"
                                                Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="mv" Property="Background" Value="{StaticResource Bg.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Path Width="19" Height="19" Stretch="Uniform" Fill="{StaticResource Online}" Data="{StaticResource Icon.Headset}"
                                          Visibility="{Binding MaximizedStream.IsMutedByMe, Converter={StaticResource InverseBoolToVis}}" />
                                    <Path Width="19" Height="19" Stretch="Uniform" Fill="{StaticResource Badge}" Data="{StaticResource Icon.HeadsetOff}"
                                          Visibility="{Binding MaximizedStream.IsMutedByMe, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                            <!-- Espectador: parar de assistir a transmissão maximizada (só para mim) -->
                            <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,14,62,0"
                                    Cursor="Hand" Click="StopWatch_Click" Tag="{Binding MaximizedStream}"
                                    ToolTip="Parar de assistir (só para você)"
                                    Visibility="{Binding MaximizedStream.IsSelf, Converter={StaticResource InverseBoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="msw" Width="40" Height="40" CornerRadius="11"
                                                Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="msw" Property="Background" Value="{StaticResource Bg.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Data="{StaticResource Icon.EyeOff}" Width="19" Height="19"
                                      Stretch="Uniform" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <!-- Espaço reservado quando parei de assistir a transmissão maximizada -->
                            <Border Background="#DD05070E"
                                    Visibility="{Binding MaximizedStream.IsWatchBlocked, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.EyeOff}" Width="30" Height="30" Stretch="Uniform"
                                          Fill="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Você parou de assistir esta transmissão" Foreground="{StaticResource Text.Primary}"
                                               FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                    <Button Content="Voltar a assistir" Click="ResumeWatch_Click" Tag="{Binding MaximizedStream}"
                                            Cursor="Hand" Margin="0,14,0,0" Padding="16,8" BorderThickness="0"
                                            Background="{StaticResource Accent}" Foreground="White"
                                            FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Headset: silenciar o áudio do PC na transmissão (verde = ligado, vermelho = mudo) -->
                        <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                                Cursor="Hand" Click="ShareAudio_Click" ToolTip="{Binding ShareAudioTip}"
                                Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVis}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="hb" Width="46" Height="46" CornerRadius="12"
                                            Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{StaticResource Bg.Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource Online}" Data="{StaticResource Icon.Headset}"
                                      Visibility="{Binding IsShareAudioMuted, Converter={StaticResource InverseBoolToVis}}" />
                                <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource Badge}" Data="{StaticResource Icon.HeadsetOff}"
                                      Visibility="{Binding IsShareAudioMuted, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>

                        <!-- Barra de controle -->
                        <Border Grid.Row="1" Background="{StaticResource Bg.Dark}" Padding="14,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource Badge}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding StreamBarText}" Foreground="{StaticResource Text.Primary}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>

                                <Button HorizontalAlignment="Right" Click="BackToChat_Click" Cursor="Hand"
                                        Foreground="White" FontWeight="SemiBold" Content="Voltar ao chat">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bc" Background="{StaticResource Badge}" CornerRadius="12"
                                                    Padding="16,8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bc" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- GALERIA de participantes (cards) -->
                    <Grid Grid.Row="1" Background="#080B14"
                          Visibility="{Binding ShowGallery, Converter={StaticResource BoolToVis}}">

                        <!-- Grade de cards -->
                        <ItemsControl ItemsSource="{Binding Gallery}" Margin="6"
                                      Visibility="{Binding IsGalleryMaximized, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="6" CornerRadius="10" Background="{Binding Background}" Cursor="Hand"
                                            ClipToBounds="True" MouseLeftButtonUp="GalleryTile_Click" Tag="{Binding}">
                                        <Grid>
                                            <!-- Fundo preto atrás da transmissão (moldura definida) -->
                                            <Border Background="#05070E"
                                                    Visibility="{Binding ShowAvatar, Converter={StaticResource InverseBoolToVis}}" />
                                            <!-- Tela transmitida INTEIRA dentro do card (sem cortar) -->
                                            <Image Source="{Binding Frame}" Stretch="Uniform" Margin="2"
                                                   RenderOptions.BitmapScalingMode="LowQuality"
                                                   Visibility="{Binding ShowAvatar, Converter={StaticResource InverseBoolToVis}}" />
                                            <!-- Avatar centralizado -->
                                            <Grid Width="92" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding ShowAvatar, Converter={StaticResource BoolToVis}}">
                                                <Border CornerRadius="46" Background="{StaticResource Brand.Gradient}">
                                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                                               FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Ellipse Width="92" Height="92">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource PathToImage}}"
                                                                    Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Ellipse Width="98" Height="98" Stroke="{StaticResource Online}" StrokeThickness="3"
                                                         Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <!-- Nome + ícones de mudo -->
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10"
                                                    Background="#80000000" CornerRadius="6" Padding="8,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.MicOff}" Width="12" Height="12" Margin="0,0,5,0"
                                                          Stretch="Uniform" Fill="{StaticResource Text.Muted}" VerticalAlignment="Center"
                                                          Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                                                    <Path Data="{StaticResource Icon.VolumeOff}" Width="12" Height="12" Margin="0,0,5,0"
                                                          Stretch="Uniform" Fill="{StaticResource Badge}" VerticalAlignment="Center"
                                                          Visibility="{Binding IsMutedByMe, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Selo AO VIVO -->
                                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"
                                                    Background="{StaticResource Badge}" CornerRadius="5" Padding="6,2"
                                                    Visibility="{Binding IsSharing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="AO VIVO" Foreground="White" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                            <!-- Headset (só no meu card ao transmitir): verde ligado / vermelho mudo -->
                                            <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10"
                                                    Cursor="Hand" Click="ShareAudio_Click"
                                                    ToolTip="{Binding DataContext.ShareAudioTip, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Visibility="{Binding ShowSelfShareControl, Converter={StaticResource BoolToVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="gh" Width="40" Height="40" CornerRadius="11"
                                                                Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="gh" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Path Width="19" Height="19" Stretch="Uniform" Fill="{StaticResource Online}"
                                                          Data="{StaticResource Icon.Headset}"
                                                          Visibility="{Binding DataContext.IsShareAudioMuted, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                                                    <Path Width="19" Height="19" Stretch="Uniform" Fill="{StaticResource Badge}"
                                                          Data="{StaticResource Icon.HeadsetOff}"
                                                          Visibility="{Binding DataContext.IsShareAudioMuted, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Button>
                                            <!-- Headset para quem ASSISTE: muta a transmissão do outro (verde ouvindo / vermelho mudo) -->
                                            <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10"
                                                    Cursor="Hand" Click="GalleryMute_Click" ToolTip="Mutar/ativar o áudio desta transmissão"
                                                    Visibility="{Binding ShowViewerMute, Converter={StaticResource BoolToVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="gv" Width="40" Height="40" CornerRadius="11"
                                                                Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="gv" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Path Width="19" Height="19" Stretch="Uniform" Fill="{StaticResource Online}"
                                                          Data="{StaticResource Icon.Headset}"
                                                          Visibility="{Binding IsMutedByMe, Converter={StaticResource InverseBoolToVis}}" />
                                                    <Path Width="19" Height="19" Stretch="Uniform" Fill="{StaticResource Badge}"
                                                          Data="{StaticResource Icon.HeadsetOff}"
                                                          Visibility="{Binding IsMutedByMe, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Button>
                                            <!-- Espectador: parar de assistir esta transmissão (só para mim) -->
                                            <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,58,0"
                                                    Cursor="Hand" Click="StopWatch_Click" Tag="{Binding}"
                                                    ToolTip="Parar de assistir (só para você)"
                                                    Visibility="{Binding ShowViewerMute, Converter={StaticResource BoolToVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="gsw" Width="40" Height="40" CornerRadius="11"
                                                                Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Soft}" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="gsw" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Path Data="{StaticResource Icon.EyeOff}" Width="19" Height="19"
                                                      Stretch="Uniform" Fill="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                            <!-- Espectador: voltar a assistir (aparece quando parei de assistir) -->
                                            <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10"
                                                    Cursor="Hand" Click="ResumeWatch_Click" Tag="{Binding}"
                                                    ToolTip="Voltar a assistir"
                                                    Visibility="{Binding ShowResumeWatch, Converter={StaticResource BoolToVis}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="grw" Width="40" Height="40" CornerRadius="11"
                                                                Background="{StaticResource Accent}" BorderThickness="0">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="grw" Property="Background" Value="{StaticResource Bg.Hover}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Path Data="{StaticResource Icon.Eye}" Width="20" Height="20"
                                                      Stretch="Uniform" Fill="White" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Card maximizado (clique para voltar) -->
                        <Grid Background="Black" Cursor="Hand" MouseLeftButtonUp="GalleryRestore_Click"
                              Visibility="{Binding IsGalleryMaximized, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding MaximizedGalleryTile.Frame}" Stretch="Uniform" Margin="8"
                                   RenderOptions.BitmapScalingMode="LowQuality" />
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14"
                                    Background="#B0000000" CornerRadius="6" Padding="10,5">
                                <TextBlock Text="{Binding MaximizedGalleryTile.Name}" Foreground="White" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Tela de boas-vindas com a logo -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
                        <local:BrandLogo Width="240" Height="240" />
                        <TextBlock Text="Bem-vindo ao Nyxar Concord" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Escolha um servidor, um canal ou uma conversa para começar."
                                   FontSize="12" Foreground="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- Painel de participantes (membros do servidor) -->
            <Border Grid.Column="1" Width="210" Background="{StaticResource Sidebar.Bg}"
                    BorderBrush="{StaticResource Border.Soft}" BorderThickness="1,0,0,0"
                    Visibility="{Binding HasServer, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MEMBROS DO SERVIDOR" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Muted}" Margin="16,16,0,8" />
                    <ItemsControl ItemsSource="{Binding ServerMembers}" Margin="8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5" Cursor="Hand" Background="Transparent"
                                      MouseLeftButtonUp="Member_Click"
                                      ContextMenuOpening="Member_ContextMenuOpening">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding MuteMenuLabel}" Click="ToggleMute_Click" />
                                            <MenuItem Header="{Binding WatchMenuLabel}" Click="ToggleWatch_Click"
                                                      Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVis}}" />
                                            <MenuItem StaysOpenOnClick="True">
                                                <MenuItem.Header>
                                                    <StackPanel Width="170" Margin="2">
                                                        <TextBlock Text="Volume" FontSize="11" Foreground="{StaticResource Text.Muted}" />
                                                        <Slider Minimum="0" Maximum="2" Width="160" TickFrequency="0.5"
                                                                Value="{Binding Volume, Mode=TwoWay}" ValueChanged="Volume_Changed" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Expulsar do canal" Click="Kick_Click" />
                                            <MenuItem Header="Banir do canal" Click="Ban_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                                        <Border CornerRadius="17" Background="{StaticResource Brand.Gradient}">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold"
                                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource PathToImage}}"
                                                            Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Stroke="{StaticResource Online}" StrokeThickness="2"
                                                 Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}" />
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Fill="{StaticResource Online}" Stroke="{StaticResource Bg.Dark}" StrokeThickness="2" />
                                        <!-- Selo de "silenciado por mim" sobre o avatar -->
                                        <Border Width="16" Height="16" CornerRadius="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{StaticResource Badge}"
                                                BorderBrush="{StaticResource Bg.Dark}" BorderThickness="2"
                                                ToolTip="Você silenciou esta pessoa"
                                                Visibility="{Binding IsMutedByMe, Converter={StaticResource BoolToVis}}">
                                            <Path Data="{StaticResource Icon.VolumeOff}" Width="9" Height="9"
                                                  Stretch="Uniform" Fill="White" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text.Primary}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Role}" Foreground="{StaticResource Text.Muted}" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Selo de administrador do servidor -->
                                        <Border Background="#26F5B301" CornerRadius="5" Padding="4,1" Margin="3,0" VerticalAlignment="Center"
                                                ToolTip="Administrador do servidor"
                                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Crown}" Width="10" Height="10" Stretch="Uniform"
                                                      Fill="{StaticResource Gold}" VerticalAlignment="Center" />
                                                <TextBlock Text="ADM" Foreground="{StaticResource Gold}" FontSize="9" FontWeight="Bold"
                                                           VerticalAlignment="Center" Margin="3,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Path Data="{StaticResource Icon.MicOff}" Width="14" Height="14" Margin="3,0"
                                              Stretch="Uniform" Fill="{StaticResource Text.Muted}"
                                              ToolTip="Microfone silenciado"
                                              Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                                        <Path Data="{StaticResource Icon.VolumeOff}" Width="14" Height="14" Margin="3,0"
                                              Stretch="Uniform" Fill="{StaticResource Badge}"
                                              ToolTip="Você silenciou esta pessoa"
                                              Visibility="{Binding IsMutedByMe, Converter={StaticResource BoolToVis}}" />
                                        <Button VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                                                BorderThickness="0" Click="Watch_Click" Margin="3,0,0,0"
                                                Visibility="{Binding IsSharingScreen, Converter={StaticResource BoolToVis}}">
                                            <Border Background="{StaticResource Badge}" CornerRadius="5" Padding="6,2">
                                                <TextBlock Text="AO VIVO" Foreground="White" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== CAIXA FLUTUANTE DE ATUALIZAÇÃO ==================== -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Width="320" CornerRadius="14" Background="{StaticResource Bg.Card}"
                BorderBrush="{StaticResource Accent.Line}" BorderThickness="1"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel Margin="18,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Brand.Gradient}"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Globe}" Fill="White" Width="18" Height="18"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Atualização disponível" FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource Text.Primary}" />
                        <TextBlock Text="{Binding UpdateVersionText}" FontSize="11"
                                   Foreground="{StaticResource Text.Muted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Progresso (durante o download) -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="8"
                                 Background="{StaticResource Bg.Input}" Foreground="{StaticResource Accent}" BorderThickness="0" />
                    <TextBlock Text="{Binding UpdateStatus}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{StaticResource Text.Muted}" />
                </StackPanel>

                <!-- Botões -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"
                            Visibility="{Binding ShowUpdateButtons, Converter={StaticResource BoolToVis}}">
                    <Button Content="Depois" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="UpdateLater_Click" />
                    <Button Content="Atualizar" Style="{StaticResource AccentButton}" Click="Update_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
