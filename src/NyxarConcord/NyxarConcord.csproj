<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NyxarConcord</RootNamespace>
    <AssemblyName>NyxarConcord</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Nyxar Concord</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Captura/reprodução de áudio (voz) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Imagens da marca (coloque nyxar.png em Assets\) -->
  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

  <!--
    Melhorias futuras de mídia:
    Codec de áudio de baixa latência (Opus):
      <PackageReference Include="Concentus" Version="2.2.2" />
    NAT traversal (STUN/TURN/ICE) e mídia WebRTC (voz + tela pela internet):
      <PackageReference Include="SIPSorcery" Version="6.2.4" />
  -->

</Project>
