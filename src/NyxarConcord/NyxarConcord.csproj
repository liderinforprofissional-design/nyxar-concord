<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NyxarConcord</RootNamespace>
    <AssemblyName>NyxarConcord</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.17.0</Version>
    <Product>Nyxar Concord</Product>
    <!-- Ãcone do app (barra de tarefas / .exe) -->
    <ApplicationIcon>Assets\nyxar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Captura/reproduÃ§Ã£o de Ã¡udio (voz) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- WebRTC (voz + tela ponto-a-ponto via STUN/TURN) -->
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <!-- Codec de vÃ­deo VP8 (compartilhamento de tela por WebRTC). O codec nativo
         (libvpx / vpxmd.dll) vem dentro deste pacote e Ã© copiado sozinho na build,
         sem precisar baixar DLLs Ã  mÃ£o como no FFmpeg. -->
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
  </ItemGroup>

  <!-- Imagens da marca (coloque nyxar.png em Assets\) -->
  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\nyxar.ico" />
  </ItemGroup>

  <!-- Supressor de ruído RNNoise (nativo). Coloque rnnoise.dll em src\NyxarConcord\rnnoise\.
       Se não existir, o app usa o supressor simples embutido automaticamente. -->
  <ItemGroup>
    <None Include="rnnoise\**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    Melhorias futuras de mÃ­dia:
    Codec de Ã¡udio de baixa latÃªncia (Opus):
      <PackageReference Include="Concentus" Version="2.2.2" />
    NAT traversal (STUN/TURN/ICE) e mÃ­dia WebRTC (voz + tela pela internet):
      <PackageReference Include="SIPSorcery" Version="6.2.4" />
  -->

</Project>
















