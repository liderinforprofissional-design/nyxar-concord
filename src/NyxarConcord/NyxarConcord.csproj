<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NyxarConcord</RootNamespace>
    <AssemblyName>NyxarConcord</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.13.0</Version>
    <Product>Nyxar Concord</Product>
    <!-- Ãcone do app (barra de tarefas / .exe) -->
    <ApplicationIcon>Assets\nyxar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Captura/reproduÃ§Ã£o de Ã¡udio (voz) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- WebRTC (voz ponto-a-ponto via TURN) -->
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <!-- Codec de vÃ­deo H264 (compartilhamento de tela por WebRTC) -->
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
  </ItemGroup>

  <!-- Imagens da marca (coloque nyxar.png em Assets\) -->
  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\nyxar.ico" />
  </ItemGroup>

  <!-- DLLs nativas do FFmpeg (H264). Baixe a build "shared" 7.x e copie os .dll
       da pasta bin para src\NyxarConcord\ffmpeg\ . Elas sÃ£o copiadas para a saÃ­da. -->
  <ItemGroup>
    <None Include="ffmpeg\**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffmpeg\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- Supressor de ruído RNNoise (nativo). Coloque rnnoise.dll em src\NyxarConcord\rnnoise\.
       Se não existir, o app usa o supressor simples embutido automaticamente. -->
  <ItemGroup>
    <None Include="rnnoise\**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    Melhorias futuras de mÃ­dia:
    Codec de Ã¡udio de baixa latÃªncia (Opus):
      <PackageReference Include="Concentus" Version="2.2.2" />
    NAT traversal (STUN/TURN/ICE) e mÃ­dia WebRTC (voz + tela pela internet):
      <PackageReference Include="SIPSorcery" Version="6.2.4" />
  -->

</Project>













